# Copiez ce fichier en « .env » et renseignez vos clés.
# ⚠️ Ne jamais committer le vrai .env (il est ignoré par git).

# Voix off des vidéos importées (requis pour l'import)
ELEVENLABS_API_KEY=

# Réécriture des scripts de narration (optionnel — repli automatique sinon)
ANTHROPIC_API_KEY=

# Mot de passe d'accès à l'interface (optionnel — vide = accès libre)
APP_PASSWORD=

# Stockage Supabase (optionnel — vide = stockage local dans imports/)
# Storage : upload des vidéos/PDF ; table `imports` : métadonnées
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=videos
# SUPABASE_TABLE=imports

# Optionnels
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ELEVEN_VOICE_ID=0igQGE0lbNpTaWsexf1r
